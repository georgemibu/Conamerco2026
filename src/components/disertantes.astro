---
import { speakers, speakerSocialNetworks } from "../data/site-content";
---

<h2 id="disertantes">DISERTANTES Y PROGRAMA</h2>
<p class="subtitulo">Conocé a quienes serán parte de XXVII CONAMERCO:</p>

<div class="disertantes">
    {
        speakers.map((speaker) => (
            <div class="disertante">
                <div class="disertante-top">
                    <img src={speaker.image} alt={`Foto de ${speaker.name}`} />
                    <div class="disertante-title">
                        <h3>{speaker.name}</h3>
                        <span class="nacionalidad">
                            <img
                                class="bandera"
                                src={`https://flagcdn.com/w40/${speaker.countryCode.toLowerCase()}.png`}
                                alt={`Bandera de ${speaker.nationality}`}
                                width="24"
                                height="18"
                                loading="lazy"
                                decoding="async"
                            />
                            {speaker.nationality}
                        </span>
                        <p>{speaker.specialty}</p>
                    </div>
                </div>
                <div class="disertante-middle">
                    <div class="calendario">
                        <img src="/calendar.png" alt="" />
                        <p>{speaker.date}</p>
                    </div>
                    <div class="hora">
                        <img src="/hora.png" alt="" />
                        <p>{speaker.time}</p>
                    </div>
                    <div class="lugar">
                        <img src="/ubicacion.png" alt="" />
                        <p>
                            <b>{speaker.city}</b><br />{speaker.venue}
                        </p>
                    </div>
                </div>
                <div class="disertante-bottom">
                    {speakerSocialNetworks.map((network) => {
                        const href = speaker.socials[network.key];

                        return href ? (
                            <a href={href} aria-label={network.name}>
                                <img src={network.image} alt="" />
                            </a>
                        ) : (
                            <span aria-label={`${network.name} (enlace pendiente)`}>
                                <img src={network.image} alt="" />
                            </span>
                        );
                    })}
                </div>
            </div>
        ))
    }
</div>
<img class="separador" src="./separador2.png" alt="" />

<style>
    h2 {
        margin: 56px 20px 0;
        color: #003d72;
        font-family: "Poppins", sans-serif;
        font-size: clamp(30px, 4vw, 40px);
        font-weight: 700;
        letter-spacing: 2px;
        text-align: center;
    }
    .subtitulo {
        margin: 0;
        color: black;
        font-family: "Poppins", sans-serif;
        font-size: clamp(15px, 2vw, 20px);
        font-weight: 500;
        letter-spacing: 1px;
        text-align: center;
    }
    .disertantes {
        display: grid;
        grid-template-columns: repeat(
            auto-fit,
            minmax(min(100%, 342px), 380px)
        );
        justify-content: center;
        align-items: stretch;
        gap: 24px;
        width: min(100% - 32px, 1200px);
        margin: 32px auto;
    }

    .disertante {
        width: 100%;
        min-height: 242px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 18px;
        padding: 20px;
        color: white;
        background: linear-gradient(
            145deg,
            #064b82 0%,
            #003d72 60%,
            #002f58 100%
        );
        border: 1px solid rgb(255 255 255 / 16%);
        border-radius: 20px;
        box-shadow: 0 12px 28px rgb(0 45 84 / 20%);
        transition:
            transform 220ms ease,
            box-shadow 220ms ease;
    }

    @media (hover: hover) and (pointer: fine) {
        .disertante:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 36px rgb(0 45 84 / 28%);
        }
    }

    .disertante-top {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .disertante-top > img {
        width: 76px;
        height: 76px;
        flex: 0 0 76px;
        object-fit: cover;
        border: 3px solid rgb(255 255 255 / 85%);
        border-radius: 50%;
        box-shadow: 0 4px 12px rgb(0 0 0 / 20%);
    }

    .disertante-title {
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        gap: 5px;
    }

    .disertante-title h3 {
        margin: 0;
        font-family: "Poppins", sans-serif;
        font-size: 18px;
        line-height: 1.25;
    }

    .nacionalidad {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: rgb(255 255 255 / 88%);
        font-size: 12px;
        line-height: 1.2;
    }

    .bandera {
        width: 24px;
        height: 18px;
        object-fit: cover;
        border-radius: 2px;
        box-shadow: 0 1px 3px rgb(0 0 0 / 25%);
    }

    .disertante-title p {
        margin: 0;
        color: rgb(255 255 255 / 82%);
        font-size: 13px;
        line-height: 1.4;
    }

    .disertante-middle {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        align-items: start;
        gap: 10px;
        padding: 14px 0;
        border-top: 1px solid rgb(255 255 255 / 20%);
        border-bottom: 1px solid rgb(255 255 255 / 20%);
    }

    .calendario,
    .hora,
    .lugar {
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        gap: 7px;
        text-align: center;
        font-size: 12px;
        line-height: 1.35;
    }

    .calendario img,
    .hora img,
    .lugar img {
        width: 22px;
        height: 22px;
        object-fit: contain;
    }

    .calendario p,
    .hora p,
    .lugar p {
        margin: 0;
    }

    .disertante-bottom {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 14px;
    }

    .disertante-bottom a,
    .disertante-bottom span {
        width: 36px;
        height: 36px;
        background-color: rgb(255 255 255 / 96%);
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        transition:
            transform 180ms ease,
            background-color 180ms ease;
    }

    .disertante-bottom a {
        text-decoration: none;
    }

    .disertante-bottom img {
        width: 19px;
        height: 19px;
        object-fit: contain;
    }

    .separador {
        display: block;
        margin: 0 auto;
        margin-top: 50px;
    }

    @media (hover: hover) and (pointer: fine) {
        .disertante-bottom a:hover {
            transform: translateY(-3px) scale(1.08);
            background-color: white;
        }
    }

    .disertante-bottom a:focus-visible {
        outline: 3px solid white;
        outline-offset: 3px;
    }

    @media (max-width: 480px) {
        .disertantes {
            grid-template-columns: minmax(0, 1fr);
            gap: 18px;
        }

        .disertante {
            padding: 18px;
        }

        .disertante-top > img {
            width: 68px;
            height: 68px;
            flex-basis: 68px;
        }

        .disertante-middle {
            gap: 8px;
        }

        .calendario,
        .hora,
        .lugar {
            font-size: 11px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .disertante,
        .disertante-bottom a,
        .disertante-bottom span {
            transition: none;
        }

        .disertante:hover,
        .disertante-bottom a:hover {
            transform: none;
        }
    }
</style>
